{
  "name": "digital-twin-wms-backend",
  "version": "1.0.0",
  "description": "Backend for Digital Twin WMS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:embed": "node dev-server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "reseed": "node -e \"require('fs').rmSync('.pg-data/.scripts_loaded', { force: true })\" && node dev-server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "nodemon": "^3.0.1"
  }
}
